{
  "name": "djlint",
  "displayName": "djLint",
  "version": "2026.11.10",
  "description": "%description%",
  "categories": [
    "Formatters",
    "Linters"
  ],
  "keywords": [
    "angular",
    "askama",
    "django",
    "djlint",
    "go template",
    "golang",
    "handlebars",
    "hugo",
    "jinja",
    "liquid",
    "mako",
    "mustache",
    "nunjucks",
    "tera",
    "twig"
  ],
  "homepage": "https://github.com/djlint/djlint-vscode",
  "bugs": {
    "url": "https://github.com/djlint/djlint-vscode/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/djlint/djlint-vscode"
  },
  "publisher": "monosans",
  "type": "module",
  "main": "./dist/extension.cjs",
  "browser": "./dist/web/extension.cjs",
  "scripts": {
    "assets": "node ./build/provision-assets.mjs",
    "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.cjs --external:vscode --format=cjs --platform=node --target=node22.20.0",
    "esbuild-web": "esbuild ./src/extension.web.ts --bundle --outfile=dist/web/extension.cjs --external:vscode --format=cjs --platform=browser --target=es2023 --alias:node:path=path-browserify",
    "esbuild-web-worker": "node ./build/esbuild-worker.mjs web",
    "esbuild-worker": "node ./build/esbuild-worker.mjs node",
    "format": "oxfmt",
    "lint": "oxlint",
    "test": "vitest run",
    "test:e2e": "node ./test/e2e/desktop.mjs",
    "test:e2e:python": "node ./test/e2e/python.mjs",
    "test:e2e:web": "node ./test/e2e/web.mjs",
    "verify-bundle": "node ./build/verify-bundle.mjs",
    "vscode:prepublish": "npm run assets && npm run esbuild-base -- --minify --metafile=dist/extension.meta.json && npm run esbuild-worker -- --minify --metafile=dist/pyodide-worker.meta.json && npm run esbuild-web -- --minify --metafile=dist/web/extension.meta.json && npm run esbuild-web-worker -- --minify --metafile=dist/web/pyodide-worker.meta.json && node ./build/third-party-notices.mjs THIRD-PARTY-NOTICES.txt dist/extension.meta.json dist/pyodide-worker.meta.json dist/web/extension.meta.json dist/web/pyodide-worker.meta.json assets/python-licenses.txt assets/pyodide-licenses.txt && node ./build/minify-package-json.mjs",
    "watch:esbuild": "npm run esbuild-base -- --sourcemap --watch",
    "watch:esbuild-worker": "npm run esbuild-worker -- --sourcemap --watch"
  },
  "dependencies": {
    "@vscode/python-environments": "1.4.0",
    "@vscode/python-extension": "1.0.6",
    "execa": "10.2.1",
    "vscode-jsonrpc": "10.0.0",
    "which-command": "0.1.0"
  },
  "devDependencies": {
    "@total-typescript/ts-reset": "0.6.1",
    "@tsconfig/node22": "22.0.6",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "22.20.5",
    "@types/vscode": "1.106.1",
    "@vitest/coverage-v8": "5.1.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/test-web": "0.0.81",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "ovsx": "1.3.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "path-browserify": "1.0.1",
    "pyodide": "314.0.7",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "vscode-languageserver-types": "3.18.5"
  },
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "djlint.restart",
        "title": "%command.restart%",
        "category": "djLint"
      },
      {
        "command": "djlint.showLogs",
        "title": "%command.showLogs%",
        "category": "djLint"
      }
    ],
    "configuration": [
      {
        "title": "%config.section.extension%",
        "order": 0,
        "properties": {
          "djlint.importStrategy": {
            "type": "string",
            "enum": [
              "fromEnvironment",
              "useBundled"
            ],
            "default": "fromEnvironment",
            "markdownEnumDescriptions": [
              "%config.importStrategy.fromEnvironment%",
              "%config.importStrategy.useBundled%"
            ],
            "markdownDescription": "%config.importStrategy%",
            "scope": "language-overridable",
            "order": 0
          },
          "djlint.executablePath": {
            "type": "string",
            "default": "",
            "markdownDescription": "%config.executablePath%",
            "scope": "language-overridable",
            "order": 1
          },
          "djlint.pythonPath": {
            "type": "string",
            "default": "",
            "markdownDescription": "%config.pythonPath%",
            "scope": "language-overridable",
            "order": 2
          },
          "djlint.useVenv": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.useVenv%",
            "scope": "language-overridable",
            "order": 3
          },
          "djlint.formatLanguages": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "django-html",
              "jinja",
              "jinja-html",
              "jinja2",
              "html-hubl",
              "hubl-html",
              "twig",
              "html-nunjucks",
              "njk",
              "nunjucks",
              "handlebars",
              "spacebars",
              "mustache",
              "htmlmustache",
              "liquid",
              "jekyll",
              "pos-liquid",
              "go-template",
              "go-tmpl",
              "gotemplate",
              "GoTemplate",
              "gohtml",
              "GoHTML",
              "gotmpl",
              "hugo-html",
              "tera",
              "tera-html",
              "askama-html",
              "mako",
              "html"
            ],
            "description": "%config.formatLanguages%",
            "order": 4
          }
        }
      },
      {
        "title": "%config.section.files%",
        "order": 1,
        "properties": {
          "djlint.exclude": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "%config.exclude%",
            "scope": "resource",
            "order": 0
          },
          "djlint.extendExclude": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "%config.extendExclude%",
            "scope": "resource",
            "order": 1
          },
          "djlint.useGitignore": {
            "type": "boolean",
            "default": false,
            "description": "%config.useGitignore%",
            "scope": "resource",
            "order": 2
          },
          "djlint.requirePragma": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "%config.requirePragma%",
            "scope": "resource",
            "order": 3
          }
        }
      },
      {
        "title": "%config.section.configuration%",
        "order": 2,
        "properties": {
          "djlint.profile": {
            "type": "string",
            "enum": [
              "",
              "all",
              "django",
              "jinja",
              "nunjucks",
              "handlebars",
              "liquid",
              "golang",
              "angular",
              "tera",
              "askama",
              "mako",
              "html"
            ],
            "enumDescriptions": [
              "%config.profile.unset%",
              "%config.profile.all%",
              "%config.profile.django%",
              "%config.profile.jinja%",
              "%config.profile.nunjucks%",
              "%config.profile.handlebars%",
              "%config.profile.liquid%",
              "%config.profile.golang%",
              "%config.profile.angular%",
              "%config.profile.tera%",
              "%config.profile.askama%",
              "%config.profile.mako%",
              "%config.profile.html%"
            ],
            "default": "",
            "scope": "language-overridable",
            "markdownDescription": "%config.profile%",
            "order": 0
          },
          "djlint.configuration": {
            "type": "string",
            "default": "",
            "markdownDescription": "%config.configuration%",
            "scope": "resource",
            "order": 1
          }
        }
      },
      {
        "title": "%config.section.linter%",
        "order": 3,
        "properties": {
          "djlint.enableLinting": {
            "type": "boolean",
            "default": false,
            "scope": "language-overridable",
            "description": "%config.enableLinting%",
            "order": 0
          },
          "djlint.lintOnType": {
            "type": "boolean",
            "default": true,
            "scope": "language-overridable",
            "markdownDescription": "%config.lintOnType%",
            "order": 1
          },
          "djlint.ignore": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "%config.ignore%",
            "scope": "resource",
            "order": 2
          },
          "djlint.include": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "%config.include%",
            "scope": "resource",
            "order": 3
          },
          "djlint.rules": {
            "type": "string",
            "default": "",
            "markdownDescription": "%config.rules%",
            "scope": "resource",
            "order": 4
          }
        }
      },
      {
        "title": "%config.section.layout%",
        "order": 4,
        "properties": {
          "djlint.useEditorIndentation": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.useEditorIndentation%",
            "scope": "resource",
            "order": 0
          },
          "djlint.maxLineLength": {
            "type": [
              "integer",
              "null"
            ],
            "default": null,
            "description": "%config.maxLineLength%",
            "scope": "resource",
            "order": 1
          },
          "djlint.maxAttributeLength": {
            "type": [
              "integer",
              "null"
            ],
            "default": null,
            "description": "%config.maxAttributeLength%",
            "scope": "resource",
            "order": 2
          },
          "djlint.singleAttributePerLine": {
            "type": "boolean",
            "default": false,
            "description": "%config.singleAttributePerLine%",
            "scope": "resource",
            "order": 3
          },
          "djlint.lineBreakAfterMultilineTag": {
            "type": "boolean",
            "default": false,
            "description": "%config.lineBreakAfterMultilineTag%",
            "scope": "resource",
            "order": 4
          },
          "djlint.noIndentInnerHtml": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "%config.noIndentInnerHtml%",
            "scope": "resource",
            "order": 5
          },
          "djlint.keepBrInline": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "%config.keepBrInline%",
            "scope": "resource",
            "order": 6
          },
          "djlint.customBlocks": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "markdownDescription": "%config.customBlocks%",
            "scope": "resource",
            "order": 7
          },
          "djlint.customHtml": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "markdownDescription": "%config.customHtml%",
            "scope": "resource",
            "order": 8
          },
          "djlint.ignoreBlocks": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "%config.ignoreBlocks%",
            "scope": "resource",
            "order": 9
          },
          "djlint.blankLineAfterTag": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "markdownDescription": "%config.blankLineAfterTag%",
            "scope": "resource",
            "order": 10
          },
          "djlint.blankLineBeforeTag": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "markdownDescription": "%config.blankLineBeforeTag%",
            "scope": "resource",
            "order": 11
          },
          "djlint.maxBlankLines": {
            "type": [
              "integer",
              "null"
            ],
            "default": null,
            "markdownDescription": "%config.maxBlankLines%",
            "scope": "resource",
            "order": 12
          },
          "djlint.preserveBlankLines": {
            "type": "boolean",
            "default": false,
            "description": "%config.preserveBlankLines%",
            "scope": "resource",
            "order": 13
          },
          "djlint.preserveLeadingSpace": {
            "type": "boolean",
            "default": false,
            "description": "%config.preserveLeadingSpace%",
            "scope": "resource",
            "order": 14
          },
          "djlint.noLineAfterYaml": {
            "type": "boolean",
            "default": false,
            "description": "%config.noLineAfterYaml%",
            "scope": "resource",
            "order": 15
          }
        }
      },
      {
        "title": "%config.section.rewrites%",
        "order": 5,
        "properties": {
          "djlint.closeVoidTags": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "%config.closeVoidTags%",
            "scope": "resource",
            "order": 0
          },
          "djlint.ignoreCase": {
            "type": "boolean",
            "default": false,
            "description": "%config.ignoreCase%",
            "scope": "resource",
            "order": 1
          },
          "djlint.sortAttributes": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "%config.sortAttributes%",
            "scope": "resource",
            "order": 2
          },
          "djlint.sortLoadTags": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "%config.sortLoadTags%",
            "scope": "resource",
            "order": 3
          },
          "djlint.nameEndblocks": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "%config.nameEndblocks%",
            "scope": "resource",
            "order": 4
          },
          "djlint.quoteStyle": {
            "type": "string",
            "enum": [
              "",
              "double",
              "single"
            ],
            "enumDescriptions": [
              "%config.quoteStyle.unset%",
              "%config.quoteStyle.double%",
              "%config.quoteStyle.single%"
            ],
            "default": "",
            "markdownDescription": "%config.quoteStyle%",
            "scope": "resource",
            "order": 5
          },
          "djlint.noEntityFormatting": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "%config.noEntityFormatting%",
            "scope": "resource",
            "order": 6
          },
          "djlint.noFunctionFormatting": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "%config.noFunctionFormatting%",
            "scope": "resource",
            "order": 7
          },
          "djlint.noSetFormatting": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "%config.noSetFormatting%",
            "scope": "resource",
            "order": 8
          },
          "djlint.preserveClassNewlines": {
            "type": "boolean",
            "default": false,
            "description": "%config.preserveClassNewlines%",
            "scope": "resource",
            "order": 9
          },
          "djlint.formatAttributeTemplateTags": {
            "type": "boolean",
            "default": false,
            "description": "%config.formatAttributeTemplateTags%",
            "scope": "resource",
            "order": 10
          }
        }
      },
      {
        "title": "%config.section.cssJs%",
        "order": 6,
        "properties": {
          "djlint.formatCss": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "%config.formatCss%",
            "scope": "resource",
            "order": 0
          },
          "djlint.indentCss": {
            "type": [
              "integer",
              "null"
            ],
            "default": null,
            "markdownDescription": "%config.indentCss%",
            "scope": "resource",
            "order": 1
          },
          "djlint.formatJs": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "%config.formatJs%",
            "scope": "resource",
            "order": 2
          },
          "djlint.indentJs": {
            "type": [
              "integer",
              "null"
            ],
            "default": null,
            "markdownDescription": "%config.indentJs%",
            "scope": "resource",
            "order": 3
          },
          "djlint.formatAttributeJsJson": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "%config.formatAttributeJsJson%",
            "scope": "resource",
            "order": 4
          },
          "djlint.formatAttributeJsJsonPattern": {
            "type": "string",
            "default": "",
            "markdownDescription": "%config.formatAttributeJsJsonPattern%",
            "scope": "resource",
            "order": 5
          },
          "djlint.formatAttributeJsJsonMinProps": {
            "type": [
              "integer",
              "null"
            ],
            "default": null,
            "description": "%config.formatAttributeJsJsonMinProps%",
            "scope": "resource",
            "order": 6
          }
        }
      }
    ],
    "configurationDefaults": {
      "[django-html]": {
        "djlint.enableLinting": true,
        "djlint.profile": "django"
      },
      "[jinja]": {
        "djlint.enableLinting": true,
        "djlint.profile": "jinja"
      },
      "[jinja-html]": {
        "djlint.enableLinting": true,
        "djlint.profile": "jinja"
      },
      "[jinja2]": {
        "djlint.enableLinting": true,
        "djlint.profile": "jinja"
      },
      "[html-hubl]": {
        "djlint.enableLinting": true,
        "djlint.profile": "jinja"
      },
      "[hubl-html]": {
        "djlint.enableLinting": true,
        "djlint.profile": "jinja"
      },
      "[twig]": {
        "djlint.enableLinting": true,
        "djlint.profile": "nunjucks"
      },
      "[html-nunjucks]": {
        "djlint.enableLinting": true,
        "djlint.profile": "nunjucks"
      },
      "[njk]": {
        "djlint.enableLinting": true,
        "djlint.profile": "nunjucks"
      },
      "[nunjucks]": {
        "djlint.enableLinting": true,
        "djlint.profile": "nunjucks"
      },
      "[handlebars]": {
        "djlint.enableLinting": true,
        "djlint.profile": "handlebars"
      },
      "[spacebars]": {
        "djlint.enableLinting": true,
        "djlint.profile": "handlebars"
      },
      "[mustache]": {
        "djlint.enableLinting": true,
        "djlint.profile": "handlebars"
      },
      "[htmlmustache]": {
        "djlint.enableLinting": true,
        "djlint.profile": "handlebars"
      },
      "[liquid]": {
        "djlint.enableLinting": true,
        "djlint.profile": "liquid"
      },
      "[jekyll]": {
        "djlint.enableLinting": true,
        "djlint.profile": "liquid"
      },
      "[pos-liquid]": {
        "djlint.enableLinting": true,
        "djlint.profile": "liquid"
      },
      "[go-template]": {
        "djlint.enableLinting": true,
        "djlint.profile": "golang"
      },
      "[go-tmpl]": {
        "djlint.enableLinting": true,
        "djlint.profile": "golang"
      },
      "[gotemplate]": {
        "djlint.enableLinting": true,
        "djlint.profile": "golang"
      },
      "[GoTemplate]": {
        "djlint.enableLinting": true,
        "djlint.profile": "golang"
      },
      "[gohtml]": {
        "djlint.enableLinting": true,
        "djlint.profile": "golang"
      },
      "[GoHTML]": {
        "djlint.enableLinting": true,
        "djlint.profile": "golang"
      },
      "[gotmpl]": {
        "djlint.enableLinting": true,
        "djlint.profile": "golang"
      },
      "[hugo-html]": {
        "djlint.enableLinting": true,
        "djlint.profile": "golang"
      },
      "[tera]": {
        "djlint.enableLinting": true,
        "djlint.profile": "tera"
      },
      "[tera-html]": {
        "djlint.enableLinting": true,
        "djlint.profile": "tera"
      },
      "[askama-html]": {
        "djlint.enableLinting": true,
        "djlint.profile": "askama"
      },
      "[mako]": {
        "djlint.enableLinting": true,
        "djlint.profile": "mako"
      },
      "[html]": {
        "djlint.enableLinting": true
      }
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "workspace"
  ],
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.106.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "restrictedConfigurations": [
        "djlint.executablePath",
        "djlint.importStrategy",
        "djlint.pythonPath",
        "djlint.useVenv",
        "djlint.configuration",
        "djlint.rules"
      ],
      "description": "%untrustedWorkspaces%"
    },
    "virtualWorkspaces": true
  }
}
