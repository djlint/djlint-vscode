{
  "name": "djlint",
  "displayName": "djLint",
  "version": "2026.11.6",
  "description": "%description%",
  "categories": [
    "Formatters",
    "Linters"
  ],
  "keywords": [
    "askama",
    "django",
    "djlint",
    "go template",
    "golang",
    "handlebars",
    "hugo",
    "jinja",
    "liquid",
    "mustache",
    "nunjucks",
    "tera",
    "twig"
  ],
  "homepage": "https://github.com/djlint/djlint-vscode",
  "bugs": {
    "url": "https://github.com/djlint/djlint-vscode/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/djlint/djlint-vscode"
  },
  "publisher": "monosans",
  "type": "module",
  "main": "./dist/extension.cjs",
  "browser": "./dist/web/extension.cjs",
  "scripts": {
    "assets": "node ./build/provision-assets.mjs",
    "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.cjs --external:vscode --format=cjs --platform=node --target=node22.20.0",
    "esbuild-web": "esbuild ./src/extension.web.ts --bundle --outfile=dist/web/extension.cjs --external:vscode --format=cjs --platform=browser --target=es2023 --alias:node:path=path-browserify",
    "esbuild-web-worker": "esbuild ./src/engine/pyodide/worker.web.ts --bundle --loader:.py=text --outfile=dist/web/pyodide-worker.js --format=iife --platform=browser --target=es2023",
    "esbuild-worker": "esbuild ./src/engine/pyodide/worker.ts --bundle --loader:.py=text --outfile=dist/pyodide-worker.cjs --format=cjs --platform=node --target=node22.20.0",
    "format": "oxfmt",
    "lint": "oxlint && tsc",
    "test": "vitest run",
    "test:e2e": "node ./test/e2e/desktop.mjs",
    "test:e2e:python": "node ./test/e2e/python.mjs",
    "test:e2e:web": "node ./test/e2e/web.mjs",
    "verify-bundle": "node ./build/verify-bundle.mjs",
    "vscode:prepublish": "npm run assets && npm run esbuild-base -- --minify --metafile=dist/extension.meta.json && npm run esbuild-worker -- --minify --metafile=dist/pyodide-worker.meta.json && npm run esbuild-web -- --minify --metafile=dist/web/extension.meta.json && npm run esbuild-web-worker -- --minify --metafile=dist/web/pyodide-worker.meta.json && node ./build/third-party-notices.mjs THIRD-PARTY-NOTICES.txt dist/extension.meta.json dist/pyodide-worker.meta.json dist/web/extension.meta.json dist/web/pyodide-worker.meta.json assets/python-licenses.txt assets/pyodide-licenses.txt && node ./build/minify-package-json.mjs",
    "watch:esbuild": "npm run esbuild-base -- --sourcemap --watch",
    "watch:esbuild-worker": "npm run esbuild-worker -- --sourcemap --watch",
    "watch:tsc": "tsc --watch"
  },
  "dependencies": {
    "@vscode/python-environments": "1.4.0",
    "@vscode/python-extension": "1.0.6",
    "execa": "10.2.1",
    "which-command": "0.1.0"
  },
  "devDependencies": {
    "@total-typescript/ts-reset": "0.6.1",
    "@tsconfig/node22": "22.0.6",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "22.20.5",
    "@types/vscode": "1.106.1",
    "@vitest/coverage-v8": "5.0.5",
    "@vscode/test-electron": "3.1.0",
    "@vscode/test-web": "0.0.81",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "ovsx": "1.3.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "path-browserify": "1.0.1",
    "pyodide": "314.0.7",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "djlint.restart",
        "title": "%command.restart%",
        "category": "djLint"
      },
      {
        "command": "djlint.showLogs",
        "title": "%command.showLogs%",
        "category": "djLint"
      }
    ],
    "configuration": {
      "properties": {
        "djlint.blankLineAfterTag": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "%config.blankLineAfterTag%",
          "scope": "resource"
        },
        "djlint.blankLineBeforeTag": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "%config.blankLineBeforeTag%",
          "scope": "resource"
        },
        "djlint.closeVoidTags": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.closeVoidTags%",
          "scope": "resource"
        },
        "djlint.configuration": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.configuration%",
          "scope": "resource"
        },
        "djlint.customBlocks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "%config.customBlocks%",
          "scope": "resource"
        },
        "djlint.customHtml": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "%config.customHtml%",
          "scope": "resource"
        },
        "djlint.enableLinting": {
          "type": "boolean",
          "default": false,
          "scope": "language-overridable",
          "description": "%config.enableLinting%"
        },
        "djlint.executablePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.executablePath%",
          "scope": "language-overridable"
        },
        "djlint.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.exclude%",
          "scope": "resource"
        },
        "djlint.extendExclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.extendExclude%",
          "scope": "resource"
        },
        "djlint.formatAttributeJsJson": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.formatAttributeJsJson%",
          "scope": "resource"
        },
        "djlint.formatAttributeJsJsonMinProps": {
          "type": [
            "integer",
            "null"
          ],
          "default": null,
          "description": "%config.formatAttributeJsJsonMinProps%",
          "scope": "resource"
        },
        "djlint.formatAttributeJsJsonPattern": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.formatAttributeJsJsonPattern%",
          "scope": "resource"
        },
        "djlint.formatAttributeTemplateTags": {
          "type": "boolean",
          "default": false,
          "description": "%config.formatAttributeTemplateTags%",
          "scope": "resource"
        },
        "djlint.formatCss": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.formatCss%",
          "scope": "resource"
        },
        "djlint.formatLanguages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "django-html",
            "jinja",
            "jinja-html",
            "jinja2",
            "html-hubl",
            "hubl-html",
            "twig",
            "html-nunjucks",
            "njk",
            "nunjucks",
            "handlebars",
            "spacebars",
            "liquid",
            "jekyll",
            "pos-liquid",
            "go-template",
            "go-tmpl",
            "gotemplate",
            "GoTemplate",
            "gohtml",
            "GoHTML",
            "gotmpl",
            "hugo-html",
            "mustache",
            "htmlmustache",
            "tera",
            "tera-html",
            "askama-html",
            "html"
          ],
          "description": "%config.formatLanguages%"
        },
        "djlint.formatJs": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.formatJs%",
          "scope": "resource"
        },
        "djlint.ignore": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.ignore%",
          "scope": "resource"
        },
        "djlint.ignoreBlocks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.ignoreBlocks%",
          "scope": "resource"
        },
        "djlint.ignoreCase": {
          "type": "boolean",
          "default": false,
          "description": "%config.ignoreCase%",
          "scope": "resource"
        },
        "djlint.importStrategy": {
          "type": "string",
          "enum": [
            "fromEnvironment",
            "useBundled"
          ],
          "default": "fromEnvironment",
          "markdownEnumDescriptions": [
            "%config.importStrategy.fromEnvironment%",
            "%config.importStrategy.useBundled%"
          ],
          "markdownDescription": "%config.importStrategy%",
          "scope": "language-overridable"
        },
        "djlint.include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.include%",
          "scope": "resource"
        },
        "djlint.indentCss": {
          "type": [
            "integer",
            "null"
          ],
          "default": null,
          "markdownDescription": "%config.indentCss%",
          "scope": "resource"
        },
        "djlint.indentJs": {
          "type": [
            "integer",
            "null"
          ],
          "default": null,
          "markdownDescription": "%config.indentJs%",
          "scope": "resource"
        },
        "djlint.keepBrInline": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.keepBrInline%",
          "scope": "resource"
        },
        "djlint.lineBreakAfterMultilineTag": {
          "type": "boolean",
          "default": false,
          "description": "%config.lineBreakAfterMultilineTag%",
          "scope": "resource"
        },
        "djlint.lintOnType": {
          "type": "boolean",
          "default": true,
          "scope": "language-overridable",
          "markdownDescription": "%config.lintOnType%"
        },
        "djlint.maxAttributeLength": {
          "type": [
            "integer",
            "null"
          ],
          "default": null,
          "description": "%config.maxAttributeLength%",
          "scope": "resource"
        },
        "djlint.maxBlankLines": {
          "type": [
            "integer",
            "null"
          ],
          "default": null,
          "markdownDescription": "%config.maxBlankLines%",
          "scope": "resource"
        },
        "djlint.maxLineLength": {
          "type": [
            "integer",
            "null"
          ],
          "default": null,
          "description": "%config.maxLineLength%",
          "scope": "resource"
        },
        "djlint.nameEndblocks": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.nameEndblocks%",
          "scope": "resource"
        },
        "djlint.noEntityFormatting": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.noEntityFormatting%",
          "scope": "resource"
        },
        "djlint.noFunctionFormatting": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.noFunctionFormatting%",
          "scope": "resource"
        },
        "djlint.noIndentInnerHtml": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.noIndentInnerHtml%",
          "scope": "resource"
        },
        "djlint.noLineAfterYaml": {
          "type": "boolean",
          "default": false,
          "description": "%config.noLineAfterYaml%",
          "scope": "resource"
        },
        "djlint.noSetFormatting": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.noSetFormatting%",
          "scope": "resource"
        },
        "djlint.preserveBlankLines": {
          "type": "boolean",
          "default": false,
          "description": "%config.preserveBlankLines%",
          "scope": "resource"
        },
        "djlint.preserveClassNewlines": {
          "type": "boolean",
          "default": false,
          "description": "%config.preserveClassNewlines%",
          "scope": "resource"
        },
        "djlint.preserveLeadingSpace": {
          "type": "boolean",
          "default": false,
          "description": "%config.preserveLeadingSpace%",
          "scope": "resource"
        },
        "djlint.profile": {
          "type": "string",
          "enum": [
            "",
            "all",
            "django",
            "jinja",
            "nunjucks",
            "handlebars",
            "liquid",
            "golang",
            "angular",
            "tera",
            "askama",
            "html"
          ],
          "enumDescriptions": [
            "%config.profile.unset%",
            "%config.profile.all%",
            "%config.profile.django%",
            "%config.profile.jinja%",
            "%config.profile.nunjucks%",
            "%config.profile.handlebars%",
            "%config.profile.liquid%",
            "%config.profile.golang%",
            "%config.profile.angular%",
            "%config.profile.tera%",
            "%config.profile.askama%",
            "%config.profile.html%"
          ],
          "default": "",
          "scope": "language-overridable",
          "markdownDescription": "%config.profile%"
        },
        "djlint.pythonPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.pythonPath%",
          "scope": "language-overridable"
        },
        "djlint.quoteStyle": {
          "type": "string",
          "enum": [
            "",
            "double",
            "single"
          ],
          "enumDescriptions": [
            "%config.quoteStyle.unset%",
            "%config.quoteStyle.double%",
            "%config.quoteStyle.single%"
          ],
          "default": "",
          "markdownDescription": "%config.quoteStyle%",
          "scope": "resource"
        },
        "djlint.requirePragma": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.requirePragma%",
          "scope": "resource"
        },
        "djlint.rules": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.rules%",
          "scope": "resource"
        },
        "djlint.singleAttributePerLine": {
          "type": "boolean",
          "default": false,
          "description": "%config.singleAttributePerLine%",
          "scope": "resource"
        },
        "djlint.sortAttributes": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.sortAttributes%",
          "scope": "resource"
        },
        "djlint.sortLoadTags": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.sortLoadTags%",
          "scope": "resource"
        },
        "djlint.useEditorIndentation": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.useEditorIndentation%",
          "scope": "resource"
        },
        "djlint.useGitignore": {
          "type": "boolean",
          "default": false,
          "description": "%config.useGitignore%",
          "scope": "resource"
        },
        "djlint.useVenv": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.useVenv%",
          "scope": "language-overridable"
        }
      }
    },
    "configurationDefaults": {
      "[django-html]": {
        "djlint.enableLinting": true,
        "djlint.profile": "django"
      },
      "[jinja]": {
        "djlint.enableLinting": true,
        "djlint.profile": "jinja"
      },
      "[jinja-html]": {
        "djlint.enableLinting": true,
        "djlint.profile": "jinja"
      },
      "[jinja2]": {
        "djlint.enableLinting": true,
        "djlint.profile": "jinja"
      },
      "[html-hubl]": {
        "djlint.enableLinting": true,
        "djlint.profile": "jinja"
      },
      "[hubl-html]": {
        "djlint.enableLinting": true,
        "djlint.profile": "jinja"
      },
      "[twig]": {
        "djlint.enableLinting": true,
        "djlint.profile": "nunjucks"
      },
      "[html-nunjucks]": {
        "djlint.enableLinting": true,
        "djlint.profile": "nunjucks"
      },
      "[njk]": {
        "djlint.enableLinting": true,
        "djlint.profile": "nunjucks"
      },
      "[nunjucks]": {
        "djlint.enableLinting": true,
        "djlint.profile": "nunjucks"
      },
      "[handlebars]": {
        "djlint.enableLinting": true,
        "djlint.profile": "handlebars"
      },
      "[spacebars]": {
        "djlint.enableLinting": true,
        "djlint.profile": "handlebars"
      },
      "[liquid]": {
        "djlint.enableLinting": true,
        "djlint.profile": "liquid"
      },
      "[jekyll]": {
        "djlint.enableLinting": true,
        "djlint.profile": "liquid"
      },
      "[pos-liquid]": {
        "djlint.enableLinting": true,
        "djlint.profile": "liquid"
      },
      "[go-template]": {
        "djlint.enableLinting": true,
        "djlint.profile": "golang"
      },
      "[go-tmpl]": {
        "djlint.enableLinting": true,
        "djlint.profile": "golang"
      },
      "[gotemplate]": {
        "djlint.enableLinting": true,
        "djlint.profile": "golang"
      },
      "[GoTemplate]": {
        "djlint.enableLinting": true,
        "djlint.profile": "golang"
      },
      "[gohtml]": {
        "djlint.enableLinting": true,
        "djlint.profile": "golang"
      },
      "[GoHTML]": {
        "djlint.enableLinting": true,
        "djlint.profile": "golang"
      },
      "[gotmpl]": {
        "djlint.enableLinting": true,
        "djlint.profile": "golang"
      },
      "[hugo-html]": {
        "djlint.enableLinting": true,
        "djlint.profile": "golang"
      },
      "[mustache]": {
        "djlint.enableLinting": true,
        "djlint.profile": "handlebars"
      },
      "[htmlmustache]": {
        "djlint.enableLinting": true,
        "djlint.profile": "handlebars"
      },
      "[tera]": {
        "djlint.enableLinting": true,
        "djlint.profile": "tera"
      },
      "[tera-html]": {
        "djlint.enableLinting": true,
        "djlint.profile": "tera"
      },
      "[askama-html]": {
        "djlint.enableLinting": true,
        "djlint.profile": "askama"
      },
      "[html]": {
        "djlint.enableLinting": true
      }
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "workspace"
  ],
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.106.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "restrictedConfigurations": [
        "djlint.executablePath",
        "djlint.importStrategy",
        "djlint.pythonPath",
        "djlint.useVenv",
        "djlint.configuration",
        "djlint.rules"
      ],
      "description": "%untrustedWorkspaces%"
    },
    "virtualWorkspaces": true
  }
}
