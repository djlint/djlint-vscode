{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "branchTopic": "{{{depNameSanitized}}}-{{{newMajor}}}{{#if separateMinorPatch}}{{#if isPatch}}.{{{newMinor}}}{{/if}}{{/if}}{{#if separateMultipleMinor}}{{#if isMinor}}.{{{newMinor}}}{{/if}}{{/if}}.x",
  "configMigration": true,
  "customManagers": [
    {
      "customType": "regex",
      "datasourceTemplate": "npm",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.yml$/"],
      "matchStrings": ["npx --yes (?<depName>@?[^@\\s]+)@(?<currentValue>\\S+)"]
    }
  ],
  "dependencyDashboard": false,
  "extends": [
    "config:recommended",
    ":disableRateLimiting",
    ":pinDevDependencies",
    "helpers:pinGitHubActionDigests"
  ],
  "lockFileMaintenance": { "enabled": true, "schedule": ["at any time"] },
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "matchPackageNames": ["prettier", "rbubley/mirrors-prettier"],
      "groupName": "prettier"
    },
    {
      "matchCurrentVersion": "!/^0/",
      "matchUpdateTypes": ["minor"],
      "automerge": true
    },
    {
      "matchUpdateTypes": ["lockFileMaintenance", "patch", "replacement"],
      "automerge": true
    },
    {
      "matchDepTypes": ["devDependencies"],
      "matchManagers": ["npm"],
      "automerge": true
    },
    { "matchManagers": ["github-actions", "pre-commit"], "automerge": true },
    {
      "description": "The Python version Pyodide runs: it moves with the pyodide package, not on its own.",
      "matchDepTypes": ["requires-python"],
      "enabled": false
    },
    {
      "matchCategories": ["js"],
      "matchPackageNames": ["@types/node"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "matchCategories": ["js"],
      "matchPackageNames": ["@types/vscode"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    }
  ],
  "pre-commit": { "enabled": true },
  "rollbackPrs": true,
  "semanticCommits": "enabled"
}
